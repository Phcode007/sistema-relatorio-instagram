generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserCompanyRole {
  OWNER
  ADMIN
  MEMBER
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  companies    UserCompany[]
}

model Company {
  id        String        @id @default(cuid())
  name      String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  users     UserCompany[]
  reports   Report[]
  instagramAccount InstagramAccount?
}

model UserCompany {
  userId    String
  companyId String
  role      UserCompanyRole @default(MEMBER)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  company   Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@id([userId, companyId])
  @@index([companyId])
}

model Report {
  id                String             @id @default(cuid())
  companyId         String
  year              Int
  month             Int
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  attendanceRecords AttendanceRecord[]
  contentRecords    ContentRecord[]
  highlight         Highlight?

  @@unique([companyId, year, month])
}

model AttendanceRecord {
  id           String   @id @default(cuid())
  reportId     String
  date         DateTime @db.Date
  messages     Int      @default(0)
  replies      Int      @default(0)
  budgets      Int      @default(0)
  reservations Int      @default(0)
  observations String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  report       Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, date])
}

model ContentRecord {
  id         String   @id @default(cuid())
  reportId   String
  date       DateTime @db.Date
  stories    Int      @default(0)
  storyViews Int      @default(0)
  reels      Int      @default(0)
  reelViews  Int      @default(0)
  engagement Decimal  @db.Decimal(5, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  report     Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, date])
}

model Highlight {
  id              String   @id @default(cuid())
  reportId        String   @unique
  bestStory       String?  @db.VarChar(200)
  bestReel        String?  @db.VarChar(200)
  recommendations String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  report          Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model InstagramAccount {
  id             String   @id @default(cuid())
  companyId      String   @unique
  igUserId       String
  igUsername     String?
  pageAccessToken String  @db.Text
  connectedAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}